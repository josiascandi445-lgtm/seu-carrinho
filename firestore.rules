rules_version = '2';

// Regras do Firestore — etapa 2 (utilizadores).
// Princípio: tudo negado por defeito; cada coleção é aberta explicitamente e com validação no servidor.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPhoto(data) {
      return !('photoDataUrl' in data)
        || (data.photoDataUrl is string
            && data.photoDataUrl.size() <= 120000
            && (data.photoDataUrl == '' || data.photoDataUrl.matches('data:image/.*')));
    }

    // Campos permitidos e validados. "role" nunca pode ser alterado pelo cliente.
    function validProfile(data) {
      return data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'photoDataUrl', 'role', 'profileCompleted', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() >= 3 && data.displayName.size() <= 80
        && data.phone is string && data.phone.size() <= 30
        && validPhoto(data)
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'customer'
        && request.resource.data.profileCompleted == true
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && validProfile(request.resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    // Tudo o resto fica fechado até às etapas seguintes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
