# Copia este ficheiro para .env.local e preenche com a configuração PÚBLICA do teu projeto Firebase.
# (Consola Firebase > Definições do projeto > As tuas apps > Configuração do SDK.)
# NUNCA coloques aqui chaves privadas, service accounts ou credenciais de administrador.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Funcionalidades que dependem do plano Blaze. Mantém "false" enquanto usares o plano Spark (gratuito).
VITE_ENABLE_STORAGE=false
VITE_ENABLE_FUNCTIONS=false

# Mostra a "Biblioteca de componentes" no Perfil (útil em desenvolvimento; desliga na versão final).
VITE_SHOW_DESIGN_SYSTEM=true
