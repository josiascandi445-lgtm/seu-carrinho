{
  "name": "seu-carrinho",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Seu Carrinho — aplicativo mobile de compras (demonstração comercial Bug Shop)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
